generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentStatus {
  PENDING
  UPCOMING
  OVERDUE
  PAID
  PARTIAL
}

enum Priority {
  ESSENTIAL
  HIGH
  MEDIUM
  LOW
}

enum Recurrence {
  NONE
  MONTHLY
  YEARLY
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  passwordHash        String
  createdAt           DateTime             @default(now())
  payments            Payment[]
  receipts            Receipt[]
  cards               Card[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Payment {
  id          String        @id @default(cuid())
  userId      String
  name        String
  category    String
  amount      Float
  dueDate     DateTime
  status      PaymentStatus @default(PENDING)
  priority    Priority      @default(MEDIUM)
  recurrence  Recurrence    @default(NONE)
  notes       String?
  paidAt      DateTime?
  paidAmount  Float?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  cancelledAt DateTime?
  seriesId String?
  seriesIndex Int?
  invoice CardInvoice?
  events      PaymentEvent[]

  @@index([userId, dueDate])
  @@index([userId, status])
}

model Receipt {
  id         String   @id @default(cuid())
  userId     String
  name       String
  category   String
  amount     Float
  expectedAt DateTime
  receivedAt DateTime?
  recurring  Boolean  @default(false)
  cancelledAt DateTime?
  seriesId String?
  seriesIndex Int?
  updatedAt DateTime @default(now()) @updatedAt
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expectedAt])
}

model Card {
  id             String   @id @default(cuid())
  userId         String
  name           String
  institution    String
  creditLimit    Float
  currentInvoice Float    @default(0)
  invoiceReviewedAt DateTime?
  archivedAt DateTime?
  invoices CardInvoice[]
  closingDay     Int
  dueDay         Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PaymentEvent {
  id String @id @default(cuid())
  paymentId String
  amount Float
  paidAt DateTime
  kind String
  createdAt DateTime @default(now())
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  @@index([paymentId, createdAt])
}

model CardInvoice {
 id String @id @default(cuid())
 cardId String
 month String
 paymentId String @unique
 card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
 payment Payment @relation(fields: [paymentId], references: [id])
 @@unique([cardId, month])
}
model RecordHistory {
 id String @id @default(cuid())
 userId String
 recordId String
 kind String
 action String
 before Json
 after Json
 createdAt DateTime @default(now())
 @@index([userId, recordId, createdAt])
}
